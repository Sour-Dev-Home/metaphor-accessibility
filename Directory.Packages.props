<Project>
  <!-- Every package version, pinned. Upgrades are deliberate changes to this file. -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <!-- Property tests of the in-game parsers (ADR 0015). BSD-3-Clause (docs/raw-sources/fscheck-licence-2026-11-19.md). -->
    <PackageVersion Include="FsCheck" Version="3.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- The installer exe's .NET Framework 4.8 reference assemblies, build-time only. MIT
         (docs/raw-sources/netframework-reference-assemblies-licence-2026-11-22.md). -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <!-- The version the official mod template references (docs/raw-sources/reloaded-ii-mod-entry-point-2026-11-15.md). -->
    <PackageVersion Include="Reloaded.Mod.Interfaces" Version="2.4.0" />
    <!-- Reloaded-II's shared hooks library, as the official template references it (ADR 0006). LGPL-3.0. -->
    <PackageVersion Include="Reloaded.SharedLib.Hooks" Version="1.9.0" />
    <!-- Its dependency, referenced directly only to ship its licence file (ADR 0006). LGPL-3.0. -->
    <PackageVersion Include="Reloaded.Hooks.Definitions" Version="1.11.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
