# Game content never enters the repository (AGENTS.md rule 4).
/game/
/extracted/
/dumps/
/captures/
*.cpk
*.pak
# The content-blocker script is the real guard; these only catch the obvious cases.
*.exe
*.dll
*.asi
*.dmp
*.mdmp
*.log
Logs/

# Disassembler and decompiler databases hold decompiled game code.
*.gpr
*.rep/
*.idb
*.i64
*.til
*.nam
*.id0
*.id1
*.id2
*.bndb
# x64dbg databases and Ghidra project locks.
*.dd64
*.lock
*.lock~

# Build output.
build/
out/
bin/
obj/
dist/
*.pdb
artifacts/
*.nupkg
TestResults/
*.trx
coverage*/
StrykerOutput/

# IDE files.
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# Local-only files and secrets.
.env
.env.*
!.env.example
*.pfx
*.pem
*.key
secrets.json
.claude/settings.local.json
.claude/pii-patterns.txt
# A dev run's files for the mod's folder (docs/contributors/how-to/deploy-a-dev-build.md): the first holds the
# maintainer's typed hero name, so a copy drafted in the tree must never be committed.
spike-player-name.txt
opt-in-*.txt

# Docs tools installed by scripts/install-docs-tools.sh.
/.tools/
node_modules/
