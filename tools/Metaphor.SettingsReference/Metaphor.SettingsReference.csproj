<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes docs/players/reference/settings.md from the settings the feature projects declare (#784, ADR 0022). A
       local tool, never shipped in the mod; Metaphor.Settings.Tests fails when the page is stale. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metaphor.Core\Metaphor.Core.csproj" />
    <ProjectReference Include="..\..\src\Metaphor.Features.Battle\Metaphor.Features.Battle.csproj" />
    <ProjectReference Include="..\..\src\Metaphor.Features.Dialogue\Metaphor.Features.Dialogue.csproj" />
    <ProjectReference Include="..\..\src\Metaphor.Features.Field\Metaphor.Features.Field.csproj" />
    <ProjectReference Include="..\..\src\Metaphor.Features.Menus\Metaphor.Features.Menus.csproj" />
    <ProjectReference Include="..\..\src\Metaphor.Features.Updates\Metaphor.Features.Updates.csproj" />
  </ItemGroup>

</Project>
