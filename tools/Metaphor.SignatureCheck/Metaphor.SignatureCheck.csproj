<Project Sdk="Microsoft.NET.Sdk">

  <!-- The offline signature check (stage 4 in issue #1), run by `scripts/check.sh signatures`. A thin wrapper: the work is in
       Metaphor.Core's SignatureCheck. A local tool, never shipped in the mod. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The probes for issue #21, read with the probes option and sent to the mod by deploy-dev.ps1 -ScanSignatures. -->
    <None Include="signature-probes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metaphor.Core\Metaphor.Core.csproj" />
  </ItemGroup>

</Project>
