<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the navigation sounds to data/sounds/ (#839): a deterministic generator, so every sound is our own work.
       A local tool, never shipped in the mod; Metaphor.Features.Field.Tests fails when the files are stale. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metaphor.Core\Metaphor.Core.csproj" />
    <ProjectReference Include="..\..\src\Metaphor.Features.Field\Metaphor.Features.Field.csproj" />
  </ItemGroup>

</Project>
