<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads files out of the game's CPK archives into the git-ignored extracted/ folder (#895). A thin wrapper: the
       reading is Metaphor.Core's CpkArchive. A local tool, never shipped in the mod. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metaphor.Core\Metaphor.Core.csproj" />
  </ItemGroup>

</Project>
