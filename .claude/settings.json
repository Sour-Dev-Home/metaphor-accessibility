{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/check/check-status.sh\" --short"
  },
  "permissions": {
    "deny": [
      "Bash(git *push *--force*)",
      "Bash(git *push -f*)",
      "Bash(git *push * -f*)",
      "Bash(git *push * +*)",
      "PowerShell(git *push *--force*)",
      "PowerShell(git *push -f*)",
      "PowerShell(git *push * -f*)",
      "PowerShell(git *push * +*)",
      "Read(**/pii-patterns.txt)",
      "Bash(cat *pii-patterns.txt*)",
      "Bash(type *pii-patterns.txt*)",
      "Bash(head *pii-patterns.txt*)",
      "Bash(tail *pii-patterns.txt*)",
      "Bash(less *pii-patterns.txt*)",
      "Bash(Get-Content *pii-patterns.txt*)",
      "PowerShell(Get-Content *pii-patterns.txt*)",
      "PowerShell(cat *pii-patterns.txt*)",
      "PowerShell(type *pii-patterns.txt*)",
      "PowerShell(head *pii-patterns.txt*)",
      "PowerShell(tail *pii-patterns.txt*)",
      "PowerShell(less *pii-patterns.txt*)",
      "Bash(*SECURITY_REVIEW_SKIP=*)",
      "Bash(export SECURITY_REVIEW_SKIP*)",
      "PowerShell(*SECURITY_REVIEW_SKIP*)",
      "Bash(git *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/refuse-log-polling.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/require-stamp-before-handback.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  }
}
