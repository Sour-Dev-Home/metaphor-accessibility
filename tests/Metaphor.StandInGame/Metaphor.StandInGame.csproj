<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for Reloaded-II's launcher and the game, so the smoke-test and deploy scripts' own tests
       (tests/pester/) run without either. See Program.cs. -->
  <PropertyGroup>
    <!-- WinExe, not Exe: the script tests start it dozens of times, and a console program opens a window each time. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Metaphor.Core\Metaphor.Core.csproj" />
  </ItemGroup>

</Project>
